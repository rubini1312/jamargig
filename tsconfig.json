{
  "compilerOptions": {
    "baseUrl": ".",

    "paths": {
      "@/*": ["*"],
      "@utils/*": ["utils/*"],
      "@api/*": ["helpers/api/*"],
      "@pages/*": ["pages/*"]
    },

    "types": ["node", "@playwright/test"],  

    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },

  "include": [
    "tests",
    "pages",
    "utils",
    "helpers",
    "test-data/dataModelConfig.ts"
  ]
}