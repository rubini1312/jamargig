{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021", "DOM"],
    "types": ["node", "@playwright/test"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    },

    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["tests", "pages", "utils"]
}